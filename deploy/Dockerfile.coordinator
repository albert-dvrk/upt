FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/coordinator
COPY coordinator/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY coordinator/ .
# Код агента: координатор заливает его на рабочие серверы по SSH
COPY agent/ /srv/agent/

COPY deploy/coordinator-entrypoint.sh /usr/local/bin/coordinator-entrypoint.sh
RUN chmod +x /usr/local/bin/coordinator-entrypoint.sh

# uid 1000 совпадает с обычным пользователем WSL — нужно, чтобы прочитать смонтированный SSH-ключ
RUN useradd -m -u 1000 app && chown -R app /srv
USER app

EXPOSE 8000
CMD ["coordinator-entrypoint.sh"]
