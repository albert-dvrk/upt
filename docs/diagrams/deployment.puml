@startuml deployment
!theme plain
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
title Лабораторный стенд (docker compose)

node "Хост (WSL / Docker)" {
  node "videofetch-coordinator\n:8001 → 8000" as C
  database "videofetch-postgres\n127.0.0.1:5433 → 5432" as P
  node "videofetch-mock\n:8080" as M
  node "worker-01\nsshd :2201" as W1
  node "worker-02\nsshd :2202" as W2
  node "worker-03\nsshd :2203" as W3
}
actor "Оператор\n(браузер)" as U

U --> C : http://localhost:8001/
C --> P : SQL (psycopg3)
C --> W1 : SSH по ключу\n(/run/secrets/worker-key)
C --> W2 : SSH
C --> W3 : SSH
W1 --> C : API агента (http://coordinator:8000)
W2 --> C
W3 --> C
W1 --> M : HTTP GET /{id}
W2 --> M
W3 --> M
@enduml
